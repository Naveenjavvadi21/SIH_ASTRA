{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start ASTRA Backend (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "astra",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "2. Start ASTRA Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "astra",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Complete ASTRA Platform",
      "dependsOn": [
        "1. Start ASTRA Backend (FastAPI)",
        "2. Start ASTRA Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
